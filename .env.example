# Copia este archivo como .env y llena los datos reales del correo.
# .env esta ignorado por git para no subir passwords.

KLIFNET_SMTP_HOST=smtp.tudominio.com
KLIFNET_SMTP_PORT=587
KLIFNET_SMTP_SECURE=false
KLIFNET_SMTP_USER=felipe.gomez@klifnet.com
KLIFNET_SMTP_PASS=tu-password-o-app-password
KLIFNET_SMTP_FROM=felipe.gomez@klifnet.com
KLIFNET_SMTP_NAME=KLIFNET CRM

# Alta de usuarios. Si no defines KLIFNET_APP_KEY, el servidor crea una en data/app-key.txt.
KLIFNET_APP_KEY=pon-aqui-tu-app-key
KLIFNET_ALLOWED_EMAILS=felipe.gomez@klifnet.com,isaacgestrada94@gmail.com

# Ejemplos comunes:
# Microsoft 365 / Outlook: smtp.office365.com, puerto 587, secure false
# Gmail: smtp.gmail.com, puerto 587, secure false, usar app password
