# KLIFNET CRM - configuracion local
# Copia este archivo como .env y llena solo los valores de tu servidor.

PORT=8787
HOST=0.0.0.0

# Correos permitidos para crear cuenta.
KLIFNET_ALLOWED_EMAILS=felipe.gomez@klifnet.com,isaacgestrada94@gmail.com

# Opcional: carpeta de datos cifrados fuera del repo.
# Si lo dejas vacio, el CRM usa ./data.
# DATA_DIR=C:\KLIFNET-CRM\data

# Opcional: llave maestra externa. Si se configura, debe ser igual en todas las PCs
# que necesiten abrir las mismas bases cifradas. No la subas a GitHub.
# KLIFNET_SECRET_KEY=

# SMTP para tokens de alta, recuperacion y correos de facturacion.
KLIFNET_SMTP_HOST=smtp.gmail.com
KLIFNET_SMTP_PORT=465
KLIFNET_SMTP_SECURE=true
KLIFNET_SMTP_USER=tu-correo@gmail.com
KLIFNET_SMTP_PASS=tu-app-password
KLIFNET_SMTP_FROM="klifnet crm <tu-correo@gmail.com>"

# IMAP opcional para extraer correos enviados.
KLIFNET_IMAP_HOST=imap.gmail.com
KLIFNET_IMAP_PORT=993
KLIFNET_IMAP_SECURE=true
KLIFNET_IMAP_USER=tu-correo@gmail.com
KLIFNET_IMAP_PASS=tu-app-password
KLIFNET_IMAP_SENT_BOX=[Gmail]/Sent Mail

# API externa de facturacion. Si no se configura, el CRM simula/valida.
KLIFNET_INVOICE_API_URL=
KLIFNET_INVOICE_API_TOKEN=
KLIFNET_INVOICE_API_TIMEOUT_MS=60000
